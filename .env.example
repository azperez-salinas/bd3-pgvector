# Hugging Face Hub: solo se usa para descargar el modelo local de embeddings.
HF_TOKEN=hf_replace_with_your_token

# Gemini genera la respuesta final usando las películas recuperadas por pgvector.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_TEMPERATURE=0.2

# Recuperación semántica
RAG_TOP_K=5
RAG_MAX_TOP_K=20

# Backend
CORS_ORIGIN=http://localhost:5173
EMBEDDER_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PGPOOL_MAX=10
